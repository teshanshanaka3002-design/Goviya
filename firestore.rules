rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isAdmin() {
      return userDocExists() && currentUser().role == 'admin';
    }

    function isBuyer() {
      return userDocExists()
        && currentUser().role == 'buyer'
        && currentUser().isDeactivated == false;
    }

    function isVerifiedFarmer() {
      return userDocExists()
        && currentUser().role == 'farmer'
        && currentUser().verified == true
        && currentUser().isDeactivated == false;
    }

    function isDriver() {
      return userDocExists()
        && currentUser().role == 'driver'
        && currentUser().isDeactivated == false;
    }

    match /users/{userId} {

      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data._id == request.auth.uid
        && request.resource.data.isDeactivated == false
        && (
          (
            request.resource.data.role == 'admin'
            && (request.auth.token.email == 'isuru@gmail.com' || request.auth.uid == 'l4lrdMR5YDWo30wrZfzAlpRYgEC3')
            && request.resource.data.email == 'isuru@gmail.com'
            && request.resource.data.verified == true
          )
          ||
          (
            request.resource.data.role == 'buyer'
            && request.resource.data.verified == true
          )
          ||
          (
            request.resource.data.role in ['farmer', 'driver']
            && request.resource.data.verified == false
          )
        );

      allow update: if isAdmin() ||
        (
          signedIn()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny([
              'uid',
              '_id',
              'role',
              'verified',
              'isDeactivated'
            ])
        );

      allow delete: if isAdmin();
    }

    match /listings/{listingId} {

      // Guests may read ACTIVE products.
      // Authenticated users may read listings needed by the app.
      allow read: if
        resource.data.status == 'active'
        || signedIn();

      // Only verified, active Farmers may create their own listings.
      allow create: if isVerifiedFarmer()
        && request.resource.data.farmerId == request.auth.uid;

      // Farmer can edit/delete only their own listing.
      // Admin can manage any listing.
      // Buyer and Driver have ZERO permission to modify listings.
      allow update: if isAdmin() ||
        (
          isVerifiedFarmer()
          && resource.data.farmerId == request.auth.uid
        );

      allow delete: if isAdmin() ||
        (
          isVerifiedFarmer()
          && resource.data.farmerId == request.auth.uid
        );
    }

    match /orders/{orderId} {

      function isBuyerOrderUpdate() {
        let isOwner = isBuyer() && resource.data.buyerId == request.auth.uid;

        let unchangedCore = request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.farmerId == resource.data.farmerId
          && request.resource.data.items == resource.data.items
          && request.resource.data.subtotal == resource.data.subtotal
          && request.resource.data.deliveryFee == resource.data.deliveryFee
          && request.resource.data.serviceFee == resource.data.serviceFee
          && request.resource.data.total == resource.data.total
          && request.resource.data.paymentMethod == resource.data.paymentMethod
          && request.resource.data.deliveryType == resource.data.deliveryType
          && (!('driverId' in resource.data)
              ? (!('driverId' in request.resource.data) || request.resource.data.driverId == null || request.resource.data.driverId == '')
              : request.resource.data.driverId == resource.data.driverId);

        // Buyer cancels pending order
        let isCancel = resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'cancellationReason',
            'updatedAt',
            'timeline'
          ]);

        // Buyer confirms direct farm gate handover
        let isFarmPickupConfirm = resource.data.status == 'ready_for_pickup'
          && resource.data.deliveryType == 'pickup'
          && request.resource.data.status == 'delivered'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'deliveredAt',
            'deliveredBy',
            'deliveryProofNote',
            'updatedAt',
            'timeline'
          ]);

        return isOwner && unchangedCore && (isCancel || isFarmPickupConfirm);
      }

      function isFarmerOrderUpdate() {
        let isOwnerFarmer = isVerifiedFarmer() && resource.data.farmerId == request.auth.uid;

        // Core identifiers and method cannot be modified by farmer
        let unchangedCore = request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.farmerId == resource.data.farmerId
          && request.resource.data.deliveryType == resource.data.deliveryType
          && request.resource.data.paymentMethod == resource.data.paymentMethod
          && (!('driverId' in resource.data)
              ? (!('driverId' in request.resource.data) || request.resource.data.driverId == null || request.resource.data.driverId == '')
              : request.resource.data.driverId == resource.data.driverId);

        // 1. Pending -> Accepted: Farmer runs runTransaction(), writes authoritative recalculated items & totals
        let isAccept = resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'items',
            'subtotal',
            'deliveryFee',
            'serviceFee',
            'total',
            'updatedAt',
            'timeline'
          ]);

        // 2. Pending -> Rejected: Farmer declines order
        let isReject = resource.data.status == 'pending'
          && request.resource.data.status == 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'rejectionReason',
            'updatedAt',
            'timeline'
          ]);

        // 3. Accepted -> Preparing: Farmer marks harvesting & crate packing
        let isPreparing = resource.data.status == 'accepted'
          && request.resource.data.status == 'preparing'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'preparationNote',
            'updatedAt',
            'timeline'
          ]);

        // 4. Preparing -> Ready for pickup: Ready at farm gate for dispatch / pickup
        let isReadyForPickup = resource.data.status == 'preparing'
          && request.resource.data.status == 'ready_for_pickup'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'preparationNote',
            'updatedAt',
            'timeline'
          ]);

        // 5. Farm Pickup Handover: Ready for pickup -> Delivered (pickup orders only)
        let isFarmHandover = resource.data.status == 'ready_for_pickup'
          && resource.data.deliveryType == 'pickup'
          && request.resource.data.status == 'delivered'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'deliveredAt',
            'deliveredBy',
            'deliveryProofNote',
            'updatedAt',
            'timeline'
          ]);

        return isOwnerFarmer && unchangedCore && (
          isAccept || isReject || isPreparing || isReadyForPickup || isFarmHandover
        );
      }

      function isDriverOrderUpdate() {
        let isEligibleDriver = isDriver();

        let unchangedCore = request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.farmerId == resource.data.farmerId
          && request.resource.data.items == resource.data.items
          && request.resource.data.subtotal == resource.data.subtotal
          && request.resource.data.deliveryFee == resource.data.deliveryFee
          && request.resource.data.serviceFee == resource.data.serviceFee
          && request.resource.data.total == resource.data.total
          && request.resource.data.paymentMethod == resource.data.paymentMethod
          && request.resource.data.deliveryType == 'delivery';

        // 1. Driver Accepts available delivery job: assigns themselves without changing status
        let isAcceptingJob = resource.data.status == 'ready_for_pickup'
          && request.resource.data.status == 'ready_for_pickup'
          && (!('driverId' in resource.data) || resource.data.driverId == null || resource.data.driverId == '')
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'driverId',
            'driverName',
            'driverPhone',
            'driverVehicle',
            'updatedAt',
            'timeline'
          ]);

        // 2. Assigned Driver marks picked up: ready_for_pickup -> out_for_delivery
        let isTransitPickup = resource.data.status == 'ready_for_pickup'
          && request.resource.data.status == 'out_for_delivery'
          && resource.data.driverId == request.auth.uid
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'pickedUpAt',
            'updatedAt',
            'timeline'
          ]);

        // 3. Assigned Driver marks delivered: out_for_delivery -> delivered
        let isTransitDelivered = resource.data.status == 'out_for_delivery'
          && request.resource.data.status == 'delivered'
          && resource.data.driverId == request.auth.uid
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'deliveredAt',
            'deliveredBy',
            'deliveryProofNote',
            'updatedAt',
            'timeline'
          ]);

        return isEligibleDriver && unchangedCore && (
          isAcceptingJob || isTransitPickup || isTransitDelivered
        );
      }

      // Role-specific order read access
      allow read: if isAdmin()
        || (
          isBuyer()
          && resource.data.buyerId == request.auth.uid
        )
        || (
          isVerifiedFarmer()
          && resource.data.farmerId == request.auth.uid
        )
        || (
          isDriver()
          && (
            resource.data.driverId == request.auth.uid
            ||
            (
              resource.data.status == 'ready_for_pickup'
              && resource.data.deliveryType == 'delivery'
            )
          )
        );

      // Only an active Buyer can create a pending order
      allow create: if isAdmin()
        || (
          isBuyer()
          && request.resource.data.buyerId == request.auth.uid
          && request.resource.data.status == 'pending'
          && (
            !('driverId' in request.resource.data)
            || request.resource.data.driverId == null
            || request.resource.data.driverId == ''
          )
        );

      // Explicitly hardened update permissions by role
      allow update: if isAdmin()
        || isBuyerOrderUpdate()
        || isFarmerOrderUpdate()
        || isDriverOrderUpdate();

      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      function isBuyerTicketOwner() {
        return isBuyer() && resource.data.buyerId == request.auth.uid;
      }

      function isBuyerTicketChatUpdate() {
        // Buyer can ONLY update parent ticket fields needed for chat updates
        let isOwner = isBuyerTicketOwner();
        let unchangedCore = request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.status == resource.data.status
          && (!('priority' in resource.data) || request.resource.data.priority == resource.data.priority);
        let allowedChatKeysOnly = request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt',
          'lastMessage',
          'lastSenderRole',
          'lastMessageSenderRole',
          'lastMessageAt'
        ]);
        return isOwner && unchangedCore && allowedChatKeysOnly;
      }

      function isAdminTicketUpdate() {
        return isAdmin()
          && request.resource.data.status in ['open', 'in_progress', 'resolved', 'closed'];
      }

      // 2. Buyer can read only their own tickets; Admin can read all tickets
      allow read: if isAdmin()
        || isBuyerTicketOwner();

      // 1. Buyer can create a ticket only when:
      // - buyerId == request.auth.uid
      // - status == 'open'
      allow create: if isAdmin()
        || (
          isBuyer()
          && request.resource.data.buyerId == request.auth.uid
          && request.resource.data.status == 'open'
        );

      // 3. Buyer must NOT be able to change status, buyerId, priority, admin fields.
      //    When Buyer sends a message, only allow parent ticket fields needed for chat updates.
      // 6. Only Admin can change ticket status (open, in_progress, resolved, closed).
      allow update: if isAdminTicketUpdate()
        || isBuyerTicketChatUpdate();

      allow delete: if isAdmin();

      match /messages/{messageId} {
        // Real-time messages read: Buyer reads messages for own ticket, Admin reads all
        allow read: if isAdmin()
          || (
            isBuyer()
            && get(/databases/$(database)/documents/tickets/$(ticketId)).data.buyerId == request.auth.uid
          );

        // 4. Buyer message creation must require:
        // - senderId == request.auth.uid
        // - senderRole == 'buyer'
        // 5. Admin message creation must require:
        // - senderRole == 'admin'
        allow create: if (
            isAdmin()
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderRole == 'admin'
          )
          || (
            isBuyer()
            && get(/databases/$(database)/documents/tickets/$(ticketId)).data.buyerId == request.auth.uid
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderRole == 'buyer'
          );

        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }
  }
}
